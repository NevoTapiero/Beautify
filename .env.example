# Copy this file to ".env" and fill in the two values from your Supabase project.
# Supabase Dashboard → Project Settings → API
#   VITE_SUPABASE_URL  = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "anon public" key (safe to expose in the browser — protected by Row Level Security)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
